# Optional overrides for environment variables.
# JSON config is preferred for persistent project settings:
#   .pi/batched-queue.json
#   package.json → pi.batchQueue
#
# See .pi/batched-queue.json.example and README.md for JSON format.
#
# Override the objective-mode model checkpoint as provider/model-id.
# BATCH_QUEUE_EXECUTOR=bifrost/vertex/google/gemini-3.7-flash
# Or configure its parts separately:
# BATCH_QUEUE_EXECUTOR_PROVIDER=bifrost
# BATCH_QUEUE_EXECUTOR_MODEL=vertex/google/gemini-3.7-flash
# Optional custom chat completions base URL and API key:
# BATCH_QUEUE_EXECUTOR_BASE_URL=http://127.0.0.1:8080/v1
# BATCH_QUEUE_EXECUTOR_API_KEY=your_key_here

# Max sequential actions per batch (default 10)
# BATCH_QUEUE_MAX_ACTIONS=10

# Objective-planned batches are read/check-only by default. Set true to allow apply_diff.
# BATCH_QUEUE_ALLOW_OBJECTIVE_MUTATIONS=false
