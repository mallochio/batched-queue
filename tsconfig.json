{
  "compilerOptions": {
    "strict": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "target": "ES2022",
    "lib": ["ES2022"],
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "types": ["bun"],
    "allowImportingTsExtensions": true,
    "noUncheckedSideEffectImports": true
  },
  "include": [
    "src/**/*.ts",
    ".opencode/**/*.ts",
    "tests/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
