{
  "name": "batched-queue",
  "version": "0.1.0",
  "description": "Stateful batched action queue Pi extension (read, grep, bash, apply_diff)",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/mallochio/batched-queue"
  },
  "pi": {
    "extensions": [
      "./src/extension.ts"
    ],
    "batchQueue": {
      "executorModel": "openai/gpt-5.4-nano",
      "maxBatchActions": 5,
      "allowObjectiveMutations": false
    }
  },
  "scripts": {
    "setup": "bun install && pi install \"$(pwd)\"",
    "setup:local": "bun install && pi install -l \"$(pwd)\"",
    "test": "bun test && bun run tests/smoke-test.ts && bun run tests/headless-test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@sinclair/typebox": "^0.34.0",
    "typescript": "^5.8.0"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "@types/bun": "^1.3.14",
    "@types/node": "^22.0.0"
  }
}
