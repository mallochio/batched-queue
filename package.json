{
  "name": "batched-queue",
  "version": "0.1.0",
  "description": "Low-latency planner-to-action batching for Prime Agent and OpenCode: batch dependent repo steps in one tool call to save tokens, with persistent shell state, result bindings, and fast-fail safety.",
  "license": "MIT",
  "type": "module",
  "main": ".opencode/plugins/batched-queue.ts",
  "exports": {
    ".": "./.opencode/plugins/batched-queue.ts",
    "./package.json": "./package.json"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "prime-agent",
    "prime-agent-extension",
    "pi",
    "opencode",
    "opencode-plugin",
    "planner-executor",
    "tool-batching",
    "action-pipeline",
    "sequential-execution"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/mallochio/batched-queue"
  },
  "pi": {
    "extensions": [
      "./src/extension.ts"
    ],
    "batchQueue": {
      "maxBatchActions": 10,
      "allowObjectiveMutations": false
    }
  },
  "opencode": {
    "batchQueue": {
      "maxBatchActions": 10,
      "allowObjectiveMutations": false
    }
  },
  "scripts": {
    "setup": "bun install && ./scripts/install.sh",
    "setup:local": "bun install && ./scripts/install.sh --local",
    "test": "bun test && bun run tests/smoke-test.ts && bun run tests/headless-test.ts && bun run tests/opencode-smoke-test.ts && bun run tests/opencode-headless-test.ts && bun run tests/opencode-objective-test.ts && bun run tests/opencode-schemas.test.ts && bun run tests/opencode-apply-diff-test.ts && bun run tests/opencode-v2-smoke-test.ts",
    "bench:deterministic": "bun run benchmarks/deterministic/run.ts",
    "bench:terminal-bench": "bash benchmarks/terminal-bench/run.sh validate",
    "bench:model-mediated": "bash benchmarks/harness/handoff.sh",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@opencode-ai/plugin": "latest",
    "@opencode/plugin": "latest",
    "@sinclair/typebox": "^0.34.0",
    "typescript": "^5.8.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    }
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "@types/bun": "^1.3.14",
    "@types/node": "^22.0.0"
  }
}
