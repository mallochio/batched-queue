{
  "name": "batched-queue",
  "version": "0.1.0",
  "description": "OpenCode 2 plugin: batch dependent repo steps into one tool call, with a persistent shell and fast-fail.",
  "license": "MIT",
  "type": "module",
  "main": ".opencode/plugins/batched-queue.ts",
  "exports": {
    ".": "./.opencode/plugins/batched-queue.ts",
    "./package.json": "./package.json"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "tool-batching"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/mallochio/batched-queue"
  },
  "scripts": {
    "test": "bun test && bun run tests/opencode-v2-smoke-test.ts && bun run tests/opencode-v2-headless-test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@opencode/plugin": "^2.0.19",
    "typebox": "*",
    "typescript": "^5.8.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/node": "^22.0.0"
  }
}
