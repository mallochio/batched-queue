{
  "name": "batched-queue",
  "version": "0.1.0",
  "description": "Batch dependent repo steps into one tool call for Prime Agent and OpenCode 2, with a persistent shell and fast-fail.",
  "license": "MIT",
  "type": "module",
  "main": ".opencode/plugins/batched-queue.ts",
  "exports": {
    ".": "./.opencode/plugins/batched-queue.ts",
    "./package.json": "./package.json"
  },
  "keywords": [
    "pi-package",
    "prime-agent",
    "prime-agent-extension",
    "opencode",
    "opencode-plugin",
    "tool-batching"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/mallochio/batched-queue"
  },
  "pi": {
    "extensions": [
      "./src/extension.ts"
    ]
  },
  "scripts": {
    "test": "bun test && bun run tests/smoke-test.ts && bun run tests/headless-test.ts && bun run tests/opencode-v2-smoke-test.ts && bun run tests/opencode-v2-headless-test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@opencode/plugin": "^2.0.19",
    "typescript": "^5.8.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    }
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "@types/bun": "^1.3.14",
    "@types/node": "^22.0.0",
    "typebox": "*"
  }
}
